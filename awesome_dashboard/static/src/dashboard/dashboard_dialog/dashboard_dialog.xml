<?xml version="1.0" encoding="UTF-8"?>
<templates xmlns:space="preserve">
    <t t-name="awesome_dashboard.DashboardSettingDialog">
        <Dialog title="'halo my dialog'">
            <div>
                <t t-foreach="props.items" t-as="item" t-key="item.id">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox"
                            t-att-id="'dashboard_item' + item.id"
                            t-model="state.checkedItems[item.id]" />
                        <label class="form-check-label" t-att-for="'dashboard_item' + item.id">
                            <t t-esc="item.description" />
                        </label>
                    </div>
                </t>
            </div>
            <div class="modal-footer">
                <button class="btn-primary" t-on-click="apply">Apply</button>
                <button class="btn-secondary" t-on-click="props.close">Cancel</button>
            </div>
        </Dialog>
    </t>
</templates>