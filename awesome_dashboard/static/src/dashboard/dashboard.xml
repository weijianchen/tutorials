<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="awesome_dashboard.AwesomeDashboard">
        <Layout display="{controlPanel: {}}" className="'o_dashboard h-100'">
            <t t-set-slot="control-panel-create-button">
                <button class="btn-primary" t-on-click="openCustomers">Customers</button>
                <button class="btn-primary" t-on-click="openLeads">Leads</button>
            </t>
            <div class="d-flex">
                <!--
                <DashboardItem>
                    <h3>new orders this month</h3>
                    <t t-esc="statics.nb_new_orders"/>
                </DashboardItem>
                <DashboardItem size="2">
                    <h3>total amount of new orders this month</h3>
                    <t t-esc="statics.total_amount"/>
                </DashboardItem>
                <DashboardItem>
                    <h3>cancelled orders this month</h3>
                    <t t-esc="statics.nb_cancelled_orders"/>
                </DashboardItem>
                <DashboardItem>
                    <h3>average t-shirt per order</h3>
                    <t t-esc="statics.average_quantity"/>
                </DashboardItem>
                <DashboardItem>
                    <h3>average time per order</h3>
                    <t t-esc="statics.average_time"/>
                </DashboardItem>
                <DashboardItem>
                    <h3>t-shirts by size</h3>
                    <PieChart data="statics.orders_by_size"/>
                </DashboardItem>
            -->
                <t t-foreach="items" t-as="item" t-key="item.id">
                    <DashboardItem size="item.size || 1">
                        <t t-set="itemProp" t-value="item.props ? item.props(statics) : {'data': statistics}"/>
                        <t t-component="item.Component" t-props="itemProp"/>
                    </DashboardItem>
                </t>
            </div>
        </Layout>
    </t>

</templates>
